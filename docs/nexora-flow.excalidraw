   "locked": false,
   "text": "The UI mirrors the API: buttons a role can't use are hidden or read-only, never shown and then refused.",
   "originalText": "The UI mirrors the API: buttons a role can't use are hidden or read-only, never shown and then refused.",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
