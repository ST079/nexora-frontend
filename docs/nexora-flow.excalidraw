   "seed": 1260730215,
   "version": 1,
   "versionNonce": 798569151,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1761264000000,
   "link": null,
   "locked": false,
   "text": "MERCHANT · Merchant hub\n• Dashboard: own revenue, orders, low and out-of-stock products\n• Products: create, edit, delete their own only (assertCanManage)\n• Images: up to 10, 5 MB each, images only · AI description (Gemini)\n• Orders: only orders with their items, trimmed to their lines + \"Your share\"\n• Order status is read-only (the Nexora team fulfils)\n• API: GET /orders/merchant · /orders/stats and /orders/count (scoped) · POST / PUT / DELETE /products (own)",
   "originalText": "MERCHANT · Merchant hub\n• Dashboard: own revenue, orders, low and out-of-stock products\n• Products: create, edit, delete their own only (assertCanManage)\n• Images: up to 10, 5 MB each, images only · AI description (Gemini)\n• Orders: only orders with their items, trimmed to their lines + \"Your share\"\n• Order status is read-only (the Nexora team fulfils)\n• API: GET /orders/merchant · /orders/stats and /orders/count (scoped) · POST / PUT / DELETE /products (own)",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "rec-0267",
   "autoResize": true,
   "lineHeight": 1.25
  },
