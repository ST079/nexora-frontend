   "versionNonce": 2671600,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1761264000000,
   "link": null,
   "locked": false,
   "text": "USER · shopper\n• Browse, filter, add to cart (capped at stock), check out\n• /orders: tabs with counts · \"N orders waiting for payment\" banner\n• Pay (COD, Khalti, card) · cancel while PENDING or CONFIRMED\n• /account: profile, avatar, address, change password\n• API: GET /orders/my-orders · GET /orders/:id (own) · PUT /users/:id/update-profile (self) · PATCH\n/users/change-password · PATCH /users/profile-image",
   "originalText": "USER · shopper\n• Browse, filter, add to cart (capped at stock), check out\n• /orders: tabs with counts · \"N orders waiting for payment\" banner\n• Pay (COD, Khalti, card) · cancel while PENDING or CONFIRMED\n• /account: profile, avatar, address, change password\n• API: GET /orders/my-orders · GET /orders/:id (own) · PUT /users/:id/update-profile (self) · PATCH\n/users/change-password · PATCH /users/profile-image",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "rec-0265",
   "autoResize": true,
   "lineHeight": 1.25
  },
