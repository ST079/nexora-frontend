  {
   "id": "tex-0268",
   "type": "text",
   "x": 1114,
   "y": 3405.62,
   "width": 992,
   "height": 148.75,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
