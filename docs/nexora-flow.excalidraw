   "link": null,
   "locked": false,
   "text": "Request → CORS (CORS_ORIGINS allowlist) → JSON body → auth (Bearer header or nexora_token cookie; re-reads roles + isActive) → checkRole → upload (Multer: images, 5 MB, ≤ 10) → validate (zod, unknown keys stripped) → controller → service → MongoDB · errors → errorMiddleware (Multer errors → 400)",
   "originalText": "Request → CORS (CORS_ORIGINS allowlist) → JSON body → auth (Bearer header or nexora_token cookie; re-reads roles + isActive) → checkRole → upload (Multer: images, 5 MB, ≤ 10) → validate (zod, unknown keys stripped) → controller → service → MongoDB · errors → errorMiddleware (Multer errors → 400)",
   "fontSize": 15,
   "fontFamily": 2,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "rec-0274",
   "autoResize": true,
   "lineHeight": 1.25
