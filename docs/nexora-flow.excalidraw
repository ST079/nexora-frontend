   "isDeleted": false,
   "boundElements": [],
   "updated": 1761264000000,
   "link": null,
   "locked": false,
   "text": "Fixed here: no stock tracking at all · restock with an undefined id could change\na random product · cancel checked the owner's roles, not the caller's · shipped\nand delivered orders could be cancelled · every order had the server start time\nas createdAt",
   "originalText": "Fixed here: no stock tracking at all · restock with an undefined id could change\na random product · cancel checked the owner's roles, not the caller's · shipped\nand delivered orders could be cancelled · every order had the server start time\nas createdAt",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "rec-0248",
   "autoResize": true,
   "lineHeight": 1.25
  },
