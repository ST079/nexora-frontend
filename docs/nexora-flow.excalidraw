  {
   "id": "tex-0266",
   "type": "text",
   "x": 54,
   "y": 3405.62,
   "width": 992,
   "height": 148.75,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
